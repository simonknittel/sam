        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sam-statistics-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, total AS \"Gesamt (USD)\", change AS \"Veränderung zum Vortag\", store AS \"Store\", in_game AS \"In-game\", unknown AS \"Nicht angegeben\"\nFROM (\n  SELECT *, total - lag(total) OVER (ORDER BY time) AS change\n  FROM (\n    SELECT\n      day::timestamp AT TIME ZONE 'Europe/Berlin' AS time,\n      round((store_value_usd_cents + in_game_value_usd_cents + unknown_value_usd_cents) / 100.0) AS total,\n      round(store_value_usd_cents / 100.0) AS store,\n      round(in_game_value_usd_cents / 100.0) AS in_game,\n      round(unknown_value_usd_cents / 100.0) AS unknown\n    FROM statistics.daily_fleet_values\n  ) AS daily_values\n) AS daily_changes\nWHERE $__timeFilter(time)\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Flottenwert (USD)",
      "type": "timeseries"
    },
