    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sam-statistics-postgres"
      },
      "description": "Gesamtanzahl eingetragener Schiffe",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisLabel": "Gesamt",
            "fillOpacity": 0,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": false
          },
          "decimals": 0,
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Veränderung zum Vortag"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Δ Vortag"
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sam-statistics-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, value AS \"Gesamt\", change AS \"Veränderung zum Vortag\"\nFROM (\n  SELECT time, value, value - lag(value) OVER (ORDER BY time) AS change\n  FROM (\n    SELECT day::timestamp AT TIME ZONE 'Europe/Berlin' AS time, sum(ship_count) AS value\n    FROM statistics.daily_ship_counts GROUP BY day\n  ) AS daily_values\n) AS daily_changes\nWHERE $__timeFilter(time)\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Flotte gesamt",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sam-statistics-postgres"
      },
      "description": "Anzahl eingetragener Schiffe pro Variante",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": false
          },
          "decimals": 0,
          "displayName": "${__field.labels.name}",
          "unit": "locale"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sam-statistics-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH counts AS (\n  SELECT * FROM (\n    SELECT day::timestamp AT TIME ZONE 'Europe/Berlin' AS time, variant_id AS id, variant_name AS name, ship_count AS value\n    FROM statistics.daily_ship_counts\n    WHERE variant_id IN (${variants:sqlstring})\n  ) AS daily_counts\n  WHERE $__timeFilter(time)\n),\nlast_values AS (\n  SELECT DISTINCT ON (id) id, name, value\n  FROM counts\n  ORDER BY id, time DESC\n),\ntop_series AS (\n  SELECT id, row_number() OVER (ORDER BY value DESC, name, id) AS position\n  FROM last_values\n  WHERE id IN (SELECT id FROM counts GROUP BY id HAVING max(value) > 0)\n  ORDER BY position\n  LIMIT ${top:sqlstring}::integer\n)\nSELECT time, id, name, value\nFROM counts\nJOIN top_series USING (id)\nORDER BY position, time",
          "refId": "A"
        }
      ],
      "title": "Flotte",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "id",
              "name"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "type": "timeseries"
    },
