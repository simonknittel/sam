{
  "name": "sam-monorepo",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build:lambda": "pnpm run --filter \"./packages/database\" build && pnpm run --filter \"./apps/lambda\" build",
    "build:scripts": "pnpm run --filter \"./packages/database\" build",
    "format": "prettier --write . && pnpm run --filter \"*\" format"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3"
  }
}
