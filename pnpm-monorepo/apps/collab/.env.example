# PostgreSQL connection, same database as the app
DATABASE_URL="postgresql://postgres:admin@localhost:5432/db"

# Shared secret with the Next.js app (COLLAB_JWT_SECRET there as well).
# Required — the server refuses to start without it. The value below matches
# compose.yml and docs/setup-local-machine.md for local development.
COLLAB_JWT_SECRET="insecure-dev-secret"

# PORT=5210
