# Database
DATABASE_URL="postgresql://postgres:admin@localhost:5432/db"

# Discord
# OAuth2 Client
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Bot. DISCORD_TOKEN is the bot token. Publishing events to Discord needs the
# bot to hold specific guild permissions, see docs/setup-local-machine.md.
DISCORD_GUILD_ID=""
DISCORD_TOKEN=""
# Optional. Defaults to https://discord.com/api/v10; only overridden to point
# at a mock server.
# DISCORD_API_BASE_URL=""

# Algolia
NEXT_PUBLIC_ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_API_KEY=""
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=""

# Amazon S3 (or any other S3-compatible provider like Cloudflare R2). The
# defaults point at the local RustFS container from compose.yml and must
# match its credentials there. For Cloudflare R2, remove S3_ENDPOINT and set
# S3_ACCOUNT_ID plus the bucket's public r2.dev host instead.
S3_ENDPOINT="http://localhost:9000"
# S3_ACCOUNT_ID=""
S3_ACCESS_KEY_ID="sam-local-dev"
S3_SECRET_ACCESS_KEY="sam-local-dev-insecure"
S3_BUCKET_NAME="uploads"
S3_PUBLIC_URL="http://localhost:9000/uploads"

# Wiki realtime collaboration (apps/collab). Optional — collaboration is
# disabled if unset.
COLLAB_JWT_SECRET="insecure-dev-secret"
COLLAB_URL="ws://localhost:5210"

# Feature flags (Unleash, or any other Unleash-compatible provider like
# GitLab). Optional — all flags evaluate to disabled if unset. The defaults
# point at the local Unleash container from compose.yml and the token must
# match its INIT_BACKEND_API_TOKENS there.
UNLEASH_SERVER_API_URL="http://localhost:4242/api"
UNLEASH_SERVER_API_TOKEN="default:development.sam-insecure-api-token"

# Signing key for the identity tokens of authenticated iframe embeds
# (docs/embedded-app-authentication.md).
# EMBED_JWT_PRIVATE_KEY=""
