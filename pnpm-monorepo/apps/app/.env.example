# Database
DATABASE_URL="postgresql://postgres:admin@localhost:5432/db"

# Next Auth Discord Provider
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
DISCORD_TOKEN=""

# Algolia
NEXT_PUBLIC_ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_API_KEY=""
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=""

# Amazon S3 (or any other S3-compatible provider like Cloudflare R2). The
# defaults point at the local RustFS container from compose.yml and must
# match its credentials there. For Cloudflare R2, remove S3_ENDPOINT and set
# S3_ACCOUNT_ID plus the bucket's public r2.dev host instead.
S3_ENDPOINT="http://localhost:9000"
# S3_ACCOUNT_ID=""
S3_ACCESS_KEY_ID="sam-local-dev"
S3_SECRET_ACCESS_KEY="sam-local-dev-insecure"
S3_BUCKET_NAME="uploads"
NEXT_PUBLIC_S3_PUBLIC_URL="http://localhost:9000/uploads"

# Wiki realtime collaboration (apps/collab). Optional — collaboration is
# disabled if unset.
COLLAB_JWT_SECRET="insecure-dev-secret"
COLLAB_URL="ws://localhost:5210"
