{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*"],
  /* The migration scripts are frozen one-off scripts (some predate breaking
     dependency upgrades and no longer compile) and are deliberately not
     typechecked. */
  "exclude": ["node_modules", "src/migrations"]
}
