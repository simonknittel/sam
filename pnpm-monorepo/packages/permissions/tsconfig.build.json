{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* If transpiling with TypeScript: */
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    /* AND if you're building for a library: */
    "declaration": true,
    /* AND if you're building for a library in a monorepo: */
    "composite": true,
    "declarationMap": true
  },
  "exclude": ["src/**/*.test.ts"]
}
