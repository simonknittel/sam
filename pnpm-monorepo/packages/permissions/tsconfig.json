/* IDE/typecheck config covering sources and tests; the emitting build
   lives in tsconfig.build.json and excludes tests. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    /* The code of this package also runs in the browser. */
    "types": []
  },
  "include": ["src/**/*.ts"]
}
