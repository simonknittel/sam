/* IDE/typecheck config covering sources and tests; the emitting build
   lives in tsconfig.build.json and excludes tests. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    /* The code of this package also runs in the browser: no Node.js globals,
       and only features that are Baseline "widely available" (ES2025 is not
       yet). */
    "types": [],
    "lib": ["es2024"]
  },
  "include": ["src/**/*.ts"]
}
