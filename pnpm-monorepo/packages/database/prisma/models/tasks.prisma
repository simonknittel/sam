/// Permission strings store values of this enum (see STATIC_PERMISSIONS in
/// the app). A rename of a value needs a migration that also updates the
/// rows of PermissionString, or the permission silently stops working.
enum TaskRewardType {
  SILC
  NEW_SILC
  TEXT
}

/// Permission strings store values of this enum (see STATIC_PERMISSIONS in
/// the app). A rename of a value needs a migration that also updates the
/// rows of PermissionString, or the permission silently stops working.
enum TaskVisibility {
  PUBLIC
  PERSONALIZED
  GROUP
}

model Task {
  id                  String            @id @default(cuid())
  title               String
  description         String?
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  createdById         String?
  createdBy           Citizen?          @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// SILC: the creator of the task pays the reward. NEW_SILC: the reward is
  /// new SILC. TEXT: a reward that is no SILC. A CHECK constraint makes sure
  /// that exactly the value column of the reward type is set (see the
  /// migration transactional_money).
  rewardType          TaskRewardType
  /// The reward for each completionist of a SILC or NEW_SILC task
  rewardSilcValue     Int?
  rewardTypeTextValue String?
  expiresAt           DateTime?         @db.Timestamptz(3)
  cancelledAt         DateTime?         @db.Timestamptz(3)
  cancelledById       String?
  cancelledBy         Citizen?          @relation("cancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  deletedAt           DateTime?         @db.Timestamptz(3)
  deletedById         String?
  deletedBy           Citizen?          @relation("deletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  visibility          TaskVisibility
  assignmentLimit     Int?
  completedAt         DateTime?         @db.Timestamptz(3)
  completedById       String?
  completedBy         Citizen?          @relation("completedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completionists      Citizen[]         @relation("completionists")
  repeatable          Int               @default(1)
  requiredRoles       Role[]            @relation("requiredRoles")
  hiddenForOtherRoles Boolean           @default(false)
  assignments         TaskAssignment[]
  canSelfComplete     Boolean           @default(false)
  readMarkers         ReadMarker[]
  silcTransactions    SilcTransaction[]
}

model TaskAssignment {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  citizenId   String
  citizen     Citizen  @relation("citizen", fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  createdById String?
  createdBy   Citizen? @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([taskId, citizenId])
  @@index([citizenId])
}
