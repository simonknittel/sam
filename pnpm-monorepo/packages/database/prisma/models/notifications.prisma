enum NotificationChannel {
  WEB_PUSH
}

/// Opt-out model: a row disables the notification type for the citizen on the
/// channel. Thus a new notification type is enabled for everyone.
model NotificationSetting {
  id               String              @id @default(cuid(2))
  citizenId        String
  citizen          Citizen             @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  notificationType String
  channel          NotificationChannel
  disabledAt       DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([citizenId, notificationType, channel])
}

model OnSiteNotification {
  id               String    @id @default(cuid(2))
  citizenId        String
  citizen          Citizen   @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  notificationType String
  payload          Json
  payloadVersion   Int       @default(1)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  readAt           DateTime? @db.Timestamptz(3)
  archivedAt       DateTime? @db.Timestamptz(3)

  @@index([citizenId, archivedAt, createdAt(sort: Desc)])
}

model WebPushSubscription {
  id        String   @id @default(cuid(2))
  citizenId String
  citizen   Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  /// User agent of the browser that saved the subscription. NULL when it is
  /// unknown.
  userAgent String?

  endpoint String @unique
  p256dh   String
  auth     String

  @@index([citizenId])
}
