model Upload {
  id                    String                   @id @default(cuid())
  fileName              String
  mimeType              String
  /// File size in bytes. NULL when it is unknown.
  size                  Int?
  /// Intrinsic image width in pixels, after EXIF orientation. Probed
  /// server-side after upload. NULL for non-images and for uploads whose
  /// probe failed or hasn't run yet — consumers must fall back gracefully.
  width                 Int?
  /// See `width`
  height                Int?
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  createdById           String?
  createdBy             Citizen?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  roleIcons             Role[]                   @relation("icon")
  roleThumbnails        Role[]                   @relation("thumbnail")
  roleTagIcons          RoleTag[]                @relation("roleTagIcon")
  manufacturers         Manufacturer[]
  eventCovers           Event[]                  @relation("eventCoverImage")
  eventTemplateCovers   EventTemplate[]          @relation("eventTemplateCoverImage")
  wikiPageLinks         WikiPageUpload[]
  wikiPageSnapshotLinks WikiPageSnapshotUpload[]
  wikiPageIcons         WikiPage[]               @relation("icon")
  wikiReports           WikiPageReport[]

  @@index([createdAt])
}
