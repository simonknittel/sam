/// SKIPPED: the citizen marked the task as done without going through the tour.
enum OnboardingTaskCompletionMethod {
  TOUR
  SKIPPED
}

/// A row means that the task is done. Task keys come from `OnboardingTaskKey`
/// of the domain package and are not backed by a foreign key. Rows with keys
/// that no longer resolve to a task are ignored when reading but kept, in case
/// the task returns.
model OnboardingTaskProgress {
  id               String                         @id @default(cuid(2))
  citizenId        String
  citizen          Citizen                        @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  taskKey          String
  completedAt      DateTime                       @db.Timestamptz(3)
  completionMethod OnboardingTaskCompletionMethod
  createdAt        DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                       @updatedAt @db.Timestamptz(3)

  @@unique([citizenId, taskKey])
}

/// Step rows exist for the resume position and for per-step timestamps only;
/// OnboardingTaskProgress is the single source of truth for "task done".
/// Replays move completedAt forward; createdAt keeps the first completion.
model OnboardingStepProgress {
  id          String   @id @default(cuid(2))
  citizenId   String
  citizen     Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  taskKey     String
  stepKey     String
  completedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([citizenId, taskKey, stepKey])
}
