/// How an onboarding task reached its completed state.
enum OnboardingTaskCompletionMethod {
  /// The citizen finished the last step of the tour.
  TOUR
  /// The citizen marked the task as done without going through the tour.
  SKIPPED
}

/// A completed onboarding task of a citizen. The existence of a row means the
/// task is done; the absence of a row means the task is open. Task keys come
/// from the static task config in the app and are not backed by a foreign
/// key. Rows with keys that no longer resolve to a task are ignored when
/// reading but kept, in case the task returns.
model OnboardingTaskProgress {
  id               String                         @id @default(cuid(2))
  citizenId        String
  citizen          Entity                         @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  taskKey          String
  completedAt      DateTime
  completionMethod OnboardingTaskCompletionMethod
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@unique([citizenId, taskKey])
  @@index([citizenId])
}

/// A completed step of an onboarding task. Step rows exist for the resume
/// position and for per-step timestamps only; OnboardingTaskProgress is the
/// single source of truth for "task done". Keys come from the static task
/// config in the app (see OnboardingTaskProgress on unresolvable keys).
/// Replays move completedAt forward; createdAt keeps the first completion.
model OnboardingStepProgress {
  id          String   @id @default(cuid(2))
  citizenId   String
  citizen     Entity   @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  taskKey     String
  stepKey     String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([citizenId, taskKey, stepKey])
  @@index([citizenId])
}
