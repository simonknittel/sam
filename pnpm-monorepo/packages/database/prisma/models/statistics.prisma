model RoleCitizenCount {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  count     Int
  /// The calendar day (Europe/Berlin) that the count is for. The midnight
  /// job writes the count of a day after its end.
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([roleId, day])
  @@index([day])
}

model VariantShipCount {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  count     Int
  /// The calendar day (Europe/Berlin) that the count is for, see
  /// RoleCitizenCount.day
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([variantId, day])
  @@index([day])
}

model DailyLoginCount {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  count     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([date])
}
