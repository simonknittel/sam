model RoleCitizenCount {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  count     Int
  /// The calendar day (Europe/Berlin) that the count is for. The midnight
  /// job writes the count of a day after its end.
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([roleId, day])
  @@index([day])
}

model VariantShipCount {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  count     Int
  /// The calendar day (Europe/Berlin) that the count is for, see
  /// RoleCitizenCount.day
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([variantId, day])
  @@index([day])
}

/// The value of the ships of the members of the organization at the end of a
/// day, for each acquisition source. A ship counts with the prices of its
/// variant at the time of the measurement: the store price (USD) and the
/// in-game price (aUEC).
model DailyFleetValue {
  id                   String   @id @default(cuid())
  /// The calendar day (Europe/Berlin) that the values are for, see
  /// RoleCitizenCount.day
  day                  DateTime @unique @db.Date
  storeValueUsdCents   BigInt
  inGameValueUsdCents  BigInt
  /// The ships without an acquisition source
  unknownValueUsdCents BigInt
  storeValueAuec       BigInt
  inGameValueAuec      BigInt
  /// The ships without an acquisition source
  unknownValueAuec     BigInt
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
}

model DailyLoginCount {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  count     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([date])
}

model DailyMcpUsageCount {
  id        String   @id @default(cuid())
  /// The calendar day (Europe/Berlin) that the count is for, see
  /// RoleCitizenCount.day
  day       DateTime @db.Date
  /// The number of the audit events of the day with `triggeredViaMcp`
  count     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([day])
}
