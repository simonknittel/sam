/// Opt-out model: a row hides the entry type for the citizen, in the calendar
/// app and on the dashboard tile, see NotificationSetting. The entry type is a
/// string, thus a new type needs no migration.
model CalendarEntryTypeSetting {
  id         String   @id @default(cuid(2))
  citizenId  String
  citizen    Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  entryType  String
  disabledAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([citizenId, entryType])
}
