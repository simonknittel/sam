/// Opt-out model: a row disables the MCP tool for one connected client (a
/// grant). Without a row, the tool is enabled. Thus new tools and new
/// grants have all tools enabled.
model McpToolSetting {
  id         String     @id @default(cuid(2))
  grantId    String
  grant      OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  toolName   String
  disabledAt DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([grantId, toolName])
}
