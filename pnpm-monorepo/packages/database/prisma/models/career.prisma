/// A career tree. The id is opaque and stable — renaming never touches it —
/// while `slug` is the URL segment and changes with a rename.
model Flow {
  id       String     @id @default(cuid(2))
  name     String
  /// URL segment of the flow. Uniqueness is enforced by a hand-written
  /// partial unique index over non-deleted rows only, so a soft-deleted flow
  /// never blocks its slug (see migration career_flow_management). Prisma
  /// cannot express partial indexes.
  slug     String
  nodes    FlowNode[]
  /// Manual ordering in the career navigation and the management list.
  /// Deliberately not unique: a reorder renumbers all affected rows inside
  /// one transaction and would otherwise need placeholder values. Assigned
  /// explicitly by the create, duplicate and reorder actions.
  position Int        @default(0)

  /// Per-role access to this flow. A tier of UPDATE implies READ, so one
  /// role never needs a second row to express both.
  roleAccess FlowRoleAccess[]

  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   Entity?   @relation("createdFlows", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   Entity?   @relation("updatedFlows", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   Entity?   @relation("deletedFlows", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([deletedAt])
}

/// UPDATE implies READ (see Flow.roleAccess).
enum FlowRoleAccessType {
  READ
  UPDATE
}

model FlowRoleAccess {
  id     String             @id @default(cuid(2))
  flowId String
  flow   Flow               @relation(fields: [flowId], references: [id], onDelete: Cascade)
  roleId String
  role   Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  type   FlowRoleAccessType

  @@unique([flowId, roleId])
  @@index([roleId])
}

model FlowNode {
  id                     String                         @id @default(cuid())
  flowId                 String
  flow                   Flow                           @relation(fields: [flowId], references: [id], onDelete: Cascade)
  positionX              Float
  positionY              Float
  width                  Float
  height                 Float
  sources                FlowEdge[]                     @relation("sources")
  targets                FlowEdge[]                     @relation("targets")
  type                   FlowNodeType
  roleId                 String?
  role                   Role?                          @relation("flowNodes", fields: [roleId], references: [id], onDelete: Cascade)
  roleImage              FlowNodeRoleImage?
  markdown               String?
  markdownPosition       FlowNodeMarkdownPosition?
  roleCitizensAlignment  FlowNodeRoleCitizensAlignment?
  roleCitizensHideRole   Boolean?
  showUnlocked           Boolean?
  backgroundColor        String?
  backgroundTransparency Float?
}

enum FlowNodeType {
  ROLE
  MARKDOWN
  ROLE_CITIZENS
}

enum FlowNodeRoleImage {
  ICON
  THUMBNAIL
}

enum FlowNodeMarkdownPosition {
  LEFT
  RIGHT
  CENTER
}

enum FlowNodeRoleCitizensAlignment {
  LEFT
  CENTER
  RIGHT
}

model FlowEdge {
  id           String   @id @default(cuid())
  type         String
  sourceId     String
  source       FlowNode @relation("sources", fields: [sourceId], references: [id], onDelete: Cascade)
  sourceHandle String
  targetId     String
  target       FlowNode @relation("targets", fields: [targetId], references: [id], onDelete: Cascade)
  targetHandle String
}
