model SilcTransaction {
  id          String    @id @default(cuid())
  receiverId  String
  receiver    Citizen   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  value       Int
  description String?
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   Citizen?  @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime?
  updatedById String?
  updatedBy   Citizen?  @relation("updatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   Citizen?  @relation("deletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  /// The source of an automatic booking. NULL for manual bookings and for
  /// bookings created before these columns existed. The partial unique
  /// indexes below make the automatic payouts idempotent: a job that runs a
  /// second time cannot book the same salary or the same collection again.
  taskId                    String?
  task                      Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  profitDistributionCycleId String?
  profitDistributionCycle   ProfitDistributionCycle? @relation(fields: [profitDistributionCycleId], references: [id], onDelete: SetNull)
  salaryRoleId              String?
  salaryRole                Role?                    @relation(fields: [salaryRoleId], references: [id], onDelete: SetNull)
  /// The calendar day (Europe/Berlin) of the salary payout
  salaryDate                DateTime?                @db.Date

  @@unique([receiverId, salaryRoleId, salaryDate], map: "SilcTransaction_salary_key", where: { deletedAt: null, salaryDate: { not: null } })
  @@unique([receiverId, profitDistributionCycleId], map: "SilcTransaction_profitDistributionCycle_key", where: { deletedAt: null, profitDistributionCycleId: { not: null } })
  @@index([receiverId, createdAt])
  @@index([createdAt])
}

model SilcSetting {
  key         SilcSettingKey @id
  value       String
  updatedAt   DateTime?      @updatedAt
  updatedBy   Citizen?       @relation("updatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
}

enum SilcSettingKey {
  AUEC_CONVERSION_RATE
}

model SilcRoleSalary {
  id         String @id @default(cuid(2))
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  value      Int
  /// 1 to 31. In a shorter month, a day after its end pays on its last day.
  dayOfMonth Int

  @@unique([roleId, dayOfMonth])
}
