model Manufacturer {
  id      String   @id @default(cuid())
  name    String   @unique
  imageId String?
  image   Upload?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  series  Series[]
}

model Series {
  id             String       @id @default(cuid())
  name           String       @unique
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  variants       Variant[]
}

model Variant {
  id                            String                         @id @default(cuid())
  name                          String
  seriesId                      String
  series                        Series                         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  ships                         Ship[]
  status                        VariantStatus?
  tags                          VariantTag[]
  eventPositionRequiredVariants EventPositionRequiredVariant[]
  shipCounts                    VariantShipCount[]
  externalLinks                 VariantExternalLink[]

  /// Wiki page whose subtree is embedded on the variant's detail page, NULL
  /// for no embed. Always a WIKI-namespace page that stays a normal page of
  /// the global wiki; several variants may link the same page. SetNull
  /// degrades a permanently deleted page to "no embed" — a soft-deleted page
  /// keeps the link and merely hides the embed while it sits in the trash.
  wikiPageId String?
  wikiPage   WikiPage? @relation("variantWikiPage", fields: [wikiPageId], references: [id], onDelete: SetNull)

  @@unique([name, seriesId])
  @@index([wikiPageId])
}

model VariantExternalLink {
  id          String  @id @default(cuid(2))
  variantId   String
  variant     Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  serviceName String
  url         String

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  createdById String?
  createdBy   Citizen? @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?
  updatedBy   Citizen? @relation("updatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([variantId, serviceName])
}

model VariantTag {
  id       String    @id @default(cuid())
  key      String
  value    String
  variants Variant[]

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  createdById String?
  createdBy   Citizen? @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?
  updatedBy   Citizen? @relation("updatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([key, value])
}

enum VariantStatus {
  FLIGHT_READY
  NOT_FLIGHT_READY
}

model Ship {
  id        String  @id @default(cuid())
  ownerId   String
  owner     Citizen @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name      String?

  createdAt   DateTime? @default(now()) @db.Timestamptz(3)
  createdById String?
  createdBy   Citizen?  @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime? @updatedAt @db.Timestamptz(3)
  updatedById String?
  updatedBy   Citizen?  @relation("updatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime? @db.Timestamptz(3)
  deletedById String?
  deletedBy   Citizen?  @relation("deletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([variantId])
}
