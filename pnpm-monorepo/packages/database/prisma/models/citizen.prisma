model Citizen {
  id                                           String                               @id @default(cuid())
  createdAt                                    DateTime                             @default(now())
  updatedAt                                    DateTime                             @updatedAt
  /// Soft delete: a deleted citizen is hidden from all lists, pickers,
  /// searches, statistics, notifications and payouts, and records that name
  /// it show "Deleted citizen". Nothing is deleted and there is no restore.
  /// The delete also removes the link to the login (`userId`).
  deletedAt                                    DateTime?
  deletedById                                  String?
  deletedBy                                    Citizen?                             @relation("deletedCitizens", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedCitizens                              Citizen[]                            @relation("deletedCitizens")
  logs                                         CitizenLog[]
  createdById                                  String?
  createdBy                                    User?                                @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  activeOrganizationsMemberships               ActiveOrganizationMembership[]
  organizationMembershipHistoryEntries         OrganizationMembershipHistoryEntry[] @relation(name: "OrganizationMembershipHistoryEntry")
  createdOrganizationMemberHistoryEntries      OrganizationMembershipHistoryEntry[] @relation(name: "CreatedOrganizationMemberHistoryEntries")
  confirmedOrganizationMemberHistoryEntries    OrganizationMembershipHistoryEntry[] @relation(name: "ConfirmedOrganizationMemberHistoryEntries")
  createdOrganizationAttributeHistoryEntries   OrganizationAttributeHistoryEntry[]  @relation(name: "CreatedOrganizationAttributeHistoryEntries")
  confirmedOrganizationAttributeHistoryEntries OrganizationAttributeHistoryEntry[]  @relation(name: "ConfirmedOrganizationAttributeHistoryEntries")
  createdOrganizations                         Organization[]                       @relation(name: "CreatedOrganizations")
  receivedSilcTransactions                     SilcTransaction[]                    @relation("receiver")
  createdSilcTransactions                      SilcTransaction[]                    @relation("createdBy")
  updatedSilcTransactions                      SilcTransaction[]                    @relation("updatedBy")
  deletedSilcTransactions                      SilcTransaction[]                    @relation("deletedBy")
  updatedSilcSettings                          SilcSetting[]                        @relation("updatedBy")
  eventManagers                                Event[]                              @relation("eventManagers")
  createdEvents                                Event[]                              @relation("createdEvents")
  deletedEvents                                Event[]                              @relation("deletedEvents")
  discordPublishedEvents                       Event[]                              @relation("discordPublishedEvents")
  eventParticipations                          EventParticipant[]                   @relation("citizen")
  cancelledEventParticipations                 EventParticipant[]                   @relation("cancelledBy")
  eventActivities                              EventActivity[]                      @relation("citizen")
  createdEventTemplates                        EventTemplate[]                      @relation("createdEventTemplates")
  updatedEventTemplates                        EventTemplate[]                      @relation("updatedEventTemplates")
  ownedEventTemplates                          EventTemplate[]                      @relation("ownedEventTemplates")
  deletedEventTemplates                        EventTemplate[]                      @relation("deletedEventTemplates")
  createdTasks                                 Task[]                               @relation("createdBy")
  cancelledTasks                               Task[]                               @relation("cancelledBy")
  deletedTasks                                 Task[]                               @relation("deletedBy")
  assignedTasks                                TaskAssignment[]                     @relation("citizen")
  completedTasks                               Task[]                               @relation("completedBy")
  createdTaskAssignments                       TaskAssignment[]                     @relation("createdBy")
  completionistsTask                           Task[]                               @relation("completionists")
  participatedProfitDistributionCycles         ProfitDistributionCycleParticipant[] @relation("citizen")
  cededProfitDistributionCycles                ProfitDistributionCycleParticipant[] @relation("cededBy")
  acceptedProfitDistributionCycles             ProfitDistributionCycleParticipant[] @relation("acceptedBy")
  disbursedProfitDistributionCycles            ProfitDistributionCycleParticipant[] @relation("disbursedBy")
  createdProfitDistributionCycles              ProfitDistributionCycle[]            @relation("createdBy")
  collectionEndedProfitDistributionCycles      ProfitDistributionCycle[]            @relation("collectionEndedBy")
  payoutStartedProfitDistributionCycles        ProfitDistributionCycle[]            @relation("payoutStartedBy")
  payoutEndedProfitDistributionCycles          ProfitDistributionCycle[]            @relation("payoutEndedBy")
  notificationSettings                         NotificationSetting[]
  onSiteNotifications                          OnSiteNotification[]
  webPushSubscriptions                         WebPushSubscription[]
  roleAssignments                              RoleAssignment[]                     @relation("citizen")
  /// Changes made by others to the roles of this citizen
  roleAssignmentChanges                        RoleAssignmentChange[]               @relation("citizen")
  /// Changes made by this citizen to the roles of other citizens
  createdRoleAssignmentChanges                 RoleAssignmentChange[]               @relation("createdBy")
  /// Changes made by others to the role level of this citizen
  roleAssignmentLevelChanges                   RoleAssignmentLevelChange[]          @relation("citizen")
  /// Changes made by this citizen to the role level of other citizens
  createdRoleAssignmentLevelChanges            RoleAssignmentLevelChange[]          @relation("createdBy")
  createdVariantExternalLinks                  VariantExternalLink[]                @relation("createdBy")
  updatedVariantExternalLinks                  VariantExternalLink[]                @relation("updatedBy")
  createdVariantTags                           VariantTag[]                         @relation("createdBy")
  updatedVariantTags                           VariantTag[]                         @relation("updatedBy")
  ships                                        Ship[]                               @relation("owner")
  uploads                                      Upload[]
  createdShips                                 Ship[]                               @relation("createdBy")
  updatedShips                                 Ship[]                               @relation("updatedBy")
  deletedShips                                 Ship[]                               @relation("deletedBy")
  unlockedBlueprints                           BlueprintUnlock[]                    @relation("citizen")
  changelogEntrySeens                          ChangelogEntrySeen[]
  bannedUsers                                  User[]                               @relation("bannedBy")
  ownedWikiPages                               WikiPage[]                           @relation("owner")
  createdWikiPages                             WikiPage[]                           @relation("createdBy")
  updatedWikiPages                             WikiPage[]                           @relation("updatedBy")
  deletedWikiPages                             WikiPage[]                           @relation("deletedBy")
  createdWikiPageSnapshots                     WikiPageSnapshot[]                   @relation("createdBy")
  wikiPageFavorites                            WikiPageFavorite[]
  wikiPageVisits                               WikiPageVisit[]
  createdWikiPageReports                       WikiPageReport[]                     @relation("createdBy")
  resolvedWikiPageReports                      WikiPageReport[]                     @relation("resolvedBy")
  createdWikiTags                              WikiTag[]                            @relation("createdBy")
  createdWikiPageTags                          WikiPageTag[]                        @relation("createdBy")
  updatedWikiSettings                          WikiSetting[]                        @relation("updatedBy")
  wikiPageMentions                             WikiPageCitizenMention[]             @relation("citizen")
  createdWikiPageCitizenMentions               WikiPageCitizenMention[]             @relation("createdBy")
  appFavorites                                 CitizenAppFavorite[]
  onboardingTaskProgresses                     OnboardingTaskProgress[]
  onboardingStepProgresses                     OnboardingStepProgress[]
  createdFlows                                 Flow[]                               @relation("createdFlows")
  updatedFlows                                 Flow[]                               @relation("updatedFlows")
  deletedFlows                                 Flow[]                               @relation("deletedFlows")
  createdLogAnalyzerEntries                    LogAnalyzerEntry[]                   @relation("createdLogAnalyzerEntries")
  seasonalThemeSettings                        SeasonalThemeSetting[]
  readMarkers                                  ReadMarker[]

  /// The login of the citizen: the user whose Discord account has the
  /// Discord ID of the citizen. Set at each sign-in and when the Discord ID
  /// of the citizen changes. NULL for citizens who never signed in.
  userId String? @unique
  user   User?   @relation("citizen", fields: [userId], references: [id], onDelete: SetNull)

  // Holds the latest confirmed values
  spectrumId                String?
  handle                    String?
  discordId                 String?
  teamspeakId               String?
  /// Number of the UEE citizen record on the RSI website
  citizenRecord             String?
  communityMoniker          String?
  createdPenaltyEntries     PenaltyEntry[]             @relation("createdBy")
  deletedPenaltyEntries     PenaltyEntry[]             @relation("deletedBy")
  penaltyEntries            PenaltyEntry[]             @relation("citizen")
  eventPositionApplications EventPositionApplication[] @relation("citizen")
  eventPositions            EventPosition[]            @relation("citizen")
  silcBalance               Int                        @default(0)
  totalEarnedSilc           Int                        @default(0)

  /// IANA time zone name of the citizen, for example "Europe/Berlin". The
  /// citizen sets it themselves. NULL if the citizen did not set it.
  timezone               String?
  /// Day of the birthday, 1 to 31. The year is not stored, thus the app
  /// cannot show an age. Set together with `birthdayMonth`, or both are NULL
  /// (CHECK constraints, see the migration database_rules_and_indexes).
  birthdayDay            Int?
  /// Month of the birthday, 1 to 12. See `birthdayDay`.
  birthdayMonth          Int?
  /// Time of the last birthday greeting. The greeting job uses it to send
  /// only one greeting for each year.
  birthdayGreetingSentAt DateTime?
  /// Time of the last New Year greeting. The greeting job uses it to send
  /// only one greeting for each year.
  newYearGreetingSentAt  DateTime?

  /// A person whose citizen was deleted can be added again, thus the IDs are
  /// unique only among the citizens that are not deleted
  @@unique([discordId], map: "Citizen_discordId_key", where: { deletedAt: null })
  @@unique([spectrumId], map: "Citizen_spectrumId_key", where: { deletedAt: null })
}

/// The history of the identity attributes of a citizen and the notes about
/// it. The latest confirmed log of each identity type is cached on `Citizen`.
model CitizenLog {
  id            String   @id @default(cuid())
  citizenId     String
  citizen       Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// One of "handle", "discord-id", "teamspeak-id", "citizen-id",
  /// "community-moniker", "spectrum-id" and "note" (a hand-written CHECK
  /// constraint, see the migration citizen_log_columns). Permission resources
  /// use the same texts, thus it is no Prisma enum.
  type          String
  content       String?  @db.Text
  submittedById String?
  submittedBy   User?    @relation("submittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  /// NULL while nobody decided about the log
  confirmed     ConfirmationStatus?
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?               @relation("confirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  /// Notes only. NULL after the note type or the classification level was
  /// deleted.
  noteTypeId            String?
  noteType              NoteType?            @relation(fields: [noteTypeId], references: [id], onDelete: SetNull)
  classificationLevelId String?
  classificationLevel   ClassificationLevel? @relation(fields: [classificationLevelId], references: [id], onDelete: SetNull)

  @@index([citizenId, type, createdAt(sort: Desc)])
}

/// Materialized/denormalized view of currently assigned roles to citizens.
/// This model is derived from the change history in `RoleAssignmentChange` and
/// `RoleAssignmentLevelChange`. Fields like `currentLevel` and
/// `currentLevelUpdatedAt` require aggregation logic. Synchronization of this
/// table with change history is handled by application logic.
model RoleAssignment {
  id                    String    @id @default(cuid(2))
  citizenId             String
  citizen               Citizen   @relation("citizen", fields: [citizenId], references: [id], onDelete: Cascade)
  roleId                String
  role                  Role      @relation("role", fields: [roleId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  /// The current level of the citizen for this role. NULL if the role does not
  /// have levels. The citizen receives the permissions of this role only when
  /// their currentLevel equals the maximum level defined in Role.maxLevel.
  /// This be handled by application logic.
  currentLevel          Int?
  /// Last time the current level was updated. NULL if the role does not have
  /// levels. This is used to determine the inactivity.
  currentLevelUpdatedAt DateTime?

  @@unique([citizenId, roleId])
  @@index([roleId])
}

enum RoleAssignmentChangeType {
  ADD
  REMOVE
}

/// History of changes to a citizen's roles
model RoleAssignmentChange {
  id          String                   @id @default(cuid(2))
  citizenId   String
  citizen     Citizen                  @relation("citizen", fields: [citizenId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role                     @relation("role", fields: [roleId], references: [id], onDelete: Cascade)
  type        RoleAssignmentChangeType
  createdAt   DateTime                 @default(now())
  createdById String?
  createdBy   Citizen?                 @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// The activity feeds page with a key of (createdAt, id)
  @@index([citizenId, createdAt, id])
  @@index([createdAt, id])
}

enum RoleAssignmentLevelChangeType {
  UP
  DOWN
}

/// History of changes to a citizen's role levels
model RoleAssignmentLevelChange {
  id          String                        @id @default(cuid(2))
  citizenId   String
  citizen     Citizen                       @relation("citizen", fields: [citizenId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role                          @relation("role", fields: [roleId], references: [id], onDelete: Cascade)
  type        RoleAssignmentLevelChangeType
  createdAt   DateTime                      @default(now())
  createdById String?
  createdBy   Citizen?                      @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// See `RoleAssignmentChange`
  @@index([citizenId, createdAt, id])
  @@index([createdAt, id])
}

/// Opt-out model for the seasonal themes: the existence of a row means the
/// seasonal event is switched off for the citizen. The absence of a row means
/// the event is switched on. Seasonal events introduced in the future are
/// therefore switched on by default for everyone. The event key is a string,
/// thus a new event needs no migration.
model SeasonalThemeSetting {
  id         String   @id @default(cuid(2))
  citizenId  String
  citizen    Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  eventKey   String
  disabledAt DateTime @default(now())

  @@unique([citizenId, eventKey])
}
