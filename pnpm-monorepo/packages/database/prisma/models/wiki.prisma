/// WIKI is the global wiki app. EVENT pages belong to exactly one event
/// (see WikiPage.eventId) and are fully isolated from the global wiki: they
/// never appear in its sidebar, search, settings or link suggestions. A
/// TASK namespace is expected to follow the same pattern later.
enum WikiPageNamespace {
  WIKI
  EVENT
}

/// Permission scopes for pages in the EVENT namespace, where the role-based
/// tiers (visibility/editability/roleAccess) are unused. Read and edit are
/// configured independently and edit never exceeds read; the uploadability
/// tiers above apply to event pages too. Manage access is not configurable:
/// the event's organizer, its managers and holders of `event;manage` always
/// manage every page.
/// MANAGERS grants only to that fixed manage set. PARTICIPANTS grants to the
/// event's Discord participants. POSITION grants to citizens assigned to a
/// position inside the referenced lineup subtree; a dangling reference
/// degrades to MANAGERS (fail closed). ALL grants to everyone with
/// `event;read`. INHERIT takes the nearest ancestor's explicit scope and is
/// not allowed on top-level pages.
enum WikiPageEventScope {
  INHERIT
  MANAGERS
  PARTICIPANTS
  POSITION
  ALL
}

/// A page never hands out more than the page above it: whoever cannot read
/// the parent gets no permission at all here, whatever this page defines.
/// RESTRICTED therefore grants read to the intersection of its role list and
/// the parent's readers, and INHERIT grants exactly the parent's readers.
/// PUBLIC is only meaningful — and only allowed — on top-level pages. A
/// "private" page is RESTRICTED with an empty role list.
enum WikiPageVisibility {
  INHERIT
  PUBLIC
  RESTRICTED
}

/// Bounded by the parent's read access like every tier (see
/// WikiPageVisibility). ALL grants edit to everyone who may read the page,
/// which on a restricted page is less than "everyone with wiki access".
/// RESTRICTED always implicitly includes the owner of the page defining the
/// setting. An "owner only" page is RESTRICTED with an empty role list.
enum WikiPageEditability {
  INHERIT
  ALL
  RESTRICTED
}

/// Who may upload while editing a page (one field per upload kind: images
/// and file attachments, fully independent of each other). Unlike the
/// permission tiers there are no role lists: RESTRICTED means only users
/// with effective admin permission on the page, EDITORS extends that to
/// everyone with effective edit permission. INHERIT at the root resolves
/// to RESTRICTED.
enum WikiPageUploadability {
  INHERIT
  EDITORS
  RESTRICTED
}

/// Controls whether a page shows up in the tree sidebar. Purely cosmetic —
/// never a permission: hidden pages stay reachable via direct links, search,
/// favorites, recents, tags and page-index nodes. HIDDEN takes the page and
/// its whole subtree out of the sidebar; CHILDREN_HIDDEN keeps the page
/// itself visible but hides all of its descendants (for "dataset" subtrees
/// with many child pages).
enum WikiPageSidebarMode {
  VISIBLE
  HIDDEN
  CHILDREN_HIDDEN
}

model WikiPage {
  id        String            @id @default(cuid(2))
  namespace WikiPageNamespace @default(WIKI)
  parentId  String?
  parent    WikiPage?         @relation("hierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  WikiPage[]        @relation("hierarchy")
  /// Manual ordering among siblings
  sortOrder Int               @default(0)

  sidebarMode WikiPageSidebarMode @default(VISIBLE)

  title  String
  /// Derived from the title. Only used for human-readable URLs. Only the id
  /// is used to resolve a page.
  slug   String
  iconId String?
  icon   Upload? @relation("icon", fields: [iconId], references: [id], onDelete: SetNull)

  /// Yjs document state. Source of truth for the page content. `content` and
  /// `searchText` are derived from it.
  ydoc       Bytes?
  /// Tiptap JSON derived from `ydoc`. Used for static rendering and snapshots.
  content    Json?
  /// Plain text extracted from `content`. Used for full-text search.
  searchText String @default("")
  /// Space-joined names of the page's tags. Denormalized because the FTS
  /// GIN index is an expression index on this table and cannot span the tag
  /// tables. Kept in sync by updateWikiPageTags.
  tagsText   String @default("")

  visibility  WikiPageVisibility   @default(INHERIT)
  editability WikiPageEditability  @default(INHERIT)
  /// Manage access has no enum: it is purely additive along the hierarchy.
  /// A page is managed by the ADMIN roles listed here plus everyone managing
  /// any of its ancestors, so owners and managers of a page always keep all
  /// three tiers on its whole subtree.
  roleAccess  WikiPageRoleAccess[]

  imageUploadability      WikiPageUploadability @default(INHERIT)
  attachmentUploadability WikiPageUploadability @default(INHERIT)

  /// The owning container for namespace EVENT: an event or an event template
  /// blueprint, exactly one of the two (enforced by a CHECK constraint, see
  /// migrations event_wiki_scoping and event_templates); both are NULL for
  /// namespace WIKI. The cascade removes the whole briefing with its
  /// container. It passes the parent relation's Restrict above because all
  /// pages of one container go in the same statement — Postgres queues the
  /// constraint triggers until the statement (including its cascades) is
  /// done.
  eventId    String?
  event      Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId String?
  template   EventTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  /// Permission configuration for namespace EVENT (see WikiPageEventScope);
  /// ignored in namespace WIKI. Inside a template these scopes are stored
  /// metadata only — access to a template's briefing follows the template's
  /// own ACL — and take effect once the tree is copied into an event. The
  /// position references are only meaningful while the matching scope is
  /// POSITION; SetNull on a deleted position intentionally degrades that
  /// scope to managers-only. The edit scope is validated to stay a subset of
  /// the read scope, and an edit scope POSITION always stores the read
  /// scope's position.
  eventReadScope           WikiPageEventScope @default(INHERIT)
  eventReadScopePositionId String?
  eventReadScopePosition   EventPosition?     @relation("wikiReadScopePages", fields: [eventReadScopePositionId], references: [id], onDelete: SetNull)
  eventEditScope           WikiPageEventScope @default(INHERIT)
  eventEditScopePositionId String?
  eventEditScopePosition   EventPosition?     @relation("wikiEditScopePages", fields: [eventEditScopePositionId], references: [id], onDelete: SetNull)

  /// The effective owner holds the implicit permissions on a page (all three
  /// tiers, implicit inclusion in RESTRICTED). NULL means the owner is
  /// inherited from the nearest ancestor with an explicit owner ("nearest
  /// setting wins", like visibility and editability); NULL at the root means
  /// no owner (only `wiki;manage` retains access). An own owner does not cut
  /// the ancestors' owners off — they keep managing the page either way — and
  /// only holds their rights while they may read the page's parent.
  /// Top-level pages start with their creator as explicit owner, child pages
  /// start inheriting.
  /// Transferable by page admins, e.g. when the owner leaves the org or
  /// switches departments. `createdBy` is a pure audit fact without any
  /// permission implications.
  ownerId String?
  owner   Entity? @relation("owner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   Entity?   @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   Entity?   @relation("updatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   Entity?   @relation("deletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  snapshots       WikiPageSnapshot[]
  favorites       WikiPageFavorite[]
  visits          WikiPageVisit[]
  reports         WikiPageReport[]
  tags            WikiPageTag[]
  citizenMentions WikiPageCitizenMention[]
  /// Uploads embedded in this page as images or attachments (see
  /// Upload.wikiPages)
  attachments     Upload[]                 @relation("attachments")
  /// Fleet variants embedding this page's subtree on their detail page (see
  /// Variant.wikiPageId)
  linkedVariants  Variant[]                @relation("variantWikiPage")

  @@index([parentId])
  @@index([deletedAt])
  @@index([eventId])
  @@index([templateId])
}

enum WikiPageAccessType {
  READ
  EDIT
  ADMIN
}

model WikiPageRoleAccess {
  id     String             @id @default(cuid(2))
  pageId String
  page   WikiPage           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  roleId String
  role   Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  type   WikiPageAccessType

  @@unique([pageId, roleId, type])
  @@index([roleId])
}

enum WikiPageSnapshotKind {
  AUTO
  MANUAL
}

model WikiPageSnapshot {
  id          String               @id @default(cuid(2))
  pageId      String
  page        WikiPage             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  kind        WikiPageSnapshotKind
  /// Optional name for MANUAL snapshots
  name        String?
  /// Tiptap JSON at snapshot time
  content     Json
  createdAt   DateTime             @default(now())
  createdById String?
  createdBy   Entity?              @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
}

model WikiPageFavorite {
  citizenId String
  citizen   Entity   @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([citizenId, pageId])
  @@index([pageId])
}

model WikiPageVisit {
  citizenId     String
  citizen       Entity   @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  pageId        String
  page          WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lastVisitedAt DateTime

  @@id([citizenId, pageId])
  @@index([citizenId, lastVisitedAt])
}

model WikiPageReport {
  id                String    @id @default(cuid(2))
  pageId            String
  page              WikiPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Set when the report targets a file attachment on the page instead of
  /// the page itself. NULL again once the upload was deleted (e.g. by the
  /// nightly cleanup after the attachment was removed from the page).
  uploadId          String?
  upload            Upload?   @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  /// Display file name of the reported attachment at report time, so the
  /// report stays meaningful after the upload was deleted.
  uploadFileName    String?
  message           String
  createdAt         DateTime  @default(now())
  createdById       String?
  createdBy         Entity?   @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        Entity?   @relation("resolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionComment String?

  @@index([pageId])
  @@index([uploadId])
  @@index([resolvedAt])
}

/// Free-form label shared by all wiki pages of one scope. Tags live in the
/// same scopes as pages — the global wiki (no container) or a single event
/// or event template — and never leak across scopes. They live only while
/// they are used: removing a tag's last assignment deletes it, and the
/// midnight automations sweep orphans left behind by permanent page
/// deletion.
model WikiTag {
  id   String @id @default(cuid(2))
  /// Display casing from first use. Uniqueness is per scope and effectively
  /// case-insensitive: actions match existing names case-insensitively
  /// (find-or-create) before creating. Enforced by partial unique indexes
  /// Prisma cannot express (see migrations event_wiki_scoping and
  /// event_templates): (name) WHERE both container columns are NULL, plus
  /// one per container column — a plain compound unique would treat every
  /// NULL container as distinct.
  name String

  /// The owning container, both NULL for the global wiki (mirrors
  /// WikiPage.eventId/templateId, and likewise at most one of the two).
  eventId    String?
  event      Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId String?
  template   EventTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   Entity?  @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  pages WikiPageTag[]

  @@index([eventId])
  @@index([templateId])
}

model WikiPageTag {
  id     String   @id @default(cuid(2))
  pageId String
  page   WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tagId  String
  tag    WikiTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   Entity?  @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([pageId, tagId])
  @@index([tagId])
}

/// One row per (page, citizen) pair the page's saved content currently
/// mentions via an @citizen mention. The collab server keeps the table in
/// lockstep with the content on every store: a new mention inserts a
/// pending row, a removed mention deletes its row — which cancels a pending
/// notification, and makes a later re-mention notify again. The 15-minute
/// notification sweep turns pending rows (both timestamps NULL) into
/// notifications. Also carries a hand-written partial index on the pending
/// predicate Prisma cannot express (see migration
/// wiki_page_citizen_mentions).
model WikiPageCitizenMention {
  id        String   @id @default(cuid(2))
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  citizenId String
  citizen   Entity   @relation("citizen", fields: [citizenId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  /// The editor whose save introduced the mention (the storing connection's
  /// editor, so best-effort within one debounced save). NULL for backfilled
  /// rows.
  createdById String?
  createdBy   Entity?  @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Set when the notification for this mention was sent.
  notifiedAt   DateTime?
  /// Set when the row was consumed without sending a notification:
  /// programmatic /replace writes (snapshot restores, paste transplants,
  /// briefing seeding), self-mentions, the backfill of pre-existing
  /// mentions, and mentions failing the read-permission gate at send time.
  suppressedAt DateTime?

  @@unique([pageId, citizenId])
  @@index([citizenId])
  @@index([createdById])
}

model WikiSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Entity?  @relation("updatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}
