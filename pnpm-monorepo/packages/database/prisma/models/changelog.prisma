/// Tracks which changelog entries a citizen has seen.
///
/// Deprecated: replaced by `ReadMarker` (subject `changelog_entry`). The app
/// of the release before the migration `changelog_read_markers` still writes
/// it, thus a later migration copies the last rows and drops the table. Do
/// not use it in new code.
model ChangelogEntrySeen {
  id        String  @id @default(cuid(2))
  citizenId String
  citizen   Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  key       String

  @@unique([citizenId, key])
}
