/// One matched log line a citizen shared with the other citizens. Rows are
/// immutable and are never deleted, thus there are no update or delete
/// columns: an opt-out only stops new uploads.
///
/// The capture groups and the rendered message are not stored. Every viewer
/// runs the type's regex on `rawLine` again, so a change of the presentation
/// applies to the whole history at once. The patterns themselves do not change
/// (see `AGENTS.md`), so that the old rows stay readable.
model LogAnalyzerEntry {
  id         String   @id @default(cuid(2))
  /// A value of the `LogAnalyzerEntryType` enum of the domain package, for
  /// example "joinPu". Not an enum of the database, so that a new pattern needs
  /// no migration. A value without a pattern is ignored when read, but kept, in
  /// case the pattern returns.
  type       String
  /// Contains data of other players (nicknames, IP addresses), thus it must
  /// never be written to the logs.
  rawLine    String
  /// Time of the event, parsed from `rawLine` by the upload (or sent by the
  /// client, for a type with `takesTimeOfPrecedingLine`). Stored as a column
  /// because the fetch queries window and sort on it.
  eventAt    DateTime @db.Timestamptz(3)
  /// The number of the line in its log file. The first line has the number 1.
  /// It orders the lines of one instant, because the game can write two lines
  /// in the same millisecond. NULL when it is unknown.
  lineNumber Int?
  /// SHA-256 of `type + "\n" + rawLine`, hex encoded. Together with
  /// `createdById` it prevents duplicates. The scope is one uploader, because
  /// two citizens can produce the same line at the same second.
  hash       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  /// The first column of the context of the entry (principle 13 of
  /// `docs/remote-control-program/README.md`): the id of the runtime that
  /// uploaded the entry, the `runtimeId` of a `RemoteControlProgramRuntime`
  /// of `createdById`. No foreign key, because the entries are immutable and
  /// stay when the row of the runtime goes. The relay sets all columns of the
  /// context. They are NULL for the entries of the upload before the Remote
  /// Control Program.
  runtimeId         String? @db.Uuid
  /// The version of the log file connector that read the entry
  /// (`CONNECTOR_CATALOG` of the domain). NULL like `runtimeId`.
  connectorVersion  Int?
  /// The version of the capability `log_entries` of the batch. NULL like
  /// `runtimeId`.
  capabilityVersion Int?

  /// The uploading citizen, also after a (soft) delete of the citizen
  createdById String?
  createdBy   Citizen? @relation("createdLogAnalyzerEntries", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([createdById, hash])
  /// Serves the initial load (window on `eventAt`) and the polling cursor
  /// (`createdAt`).
  @@index([eventAt])
  @@index([createdAt])
  /// Serves the reads of the Remote Control Program: the entries of the
  /// owners that a viewer can read, in the time range of the grants.
  @@index([createdById, eventAt])
}
