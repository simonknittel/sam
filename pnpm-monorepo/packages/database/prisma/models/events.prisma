/// Where an event originates. DISCORD events are mirrored by the sync Lambda
/// and their core data stays read-only in the app; APP events are created
/// and fully managed inside the app.
enum EventSource {
  DISCORD
  APP
}

/// PUBLIC events are visible to everyone with `event;read`. RESTRICTED
/// events are only visible to holders of the selected roles
/// (EventVisibilityRole), the event's creator, its managers and holders of
/// `event;manage`.
enum EventVisibility {
  PUBLIC
  RESTRICTED
}

model Event {
  id     String      @id @default(cuid())
  source EventSource

  // Discord-sourced events only (source DISCORD)
  discordId        String? @unique
  discordCreatorId String?
  discordImage     String?
  discordGuildId   String?

  name        String
  startTime   DateTime
  endTime     DateTime?
  description String?
  location    String?

  /// Cover image of app events, uploaded by the organizer. Discord events
  /// use discordImage (a Discord CDN reference) instead.
  coverImageId String?
  coverImage   Upload? @relation("eventCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The creating citizen of app events; backfilled for Discord events
  /// whose Discord creator matches a citizen's Discord id.
  createdById String?
  createdBy   Entity? @relation("createdEvents", fields: [createdById], references: [id], onDelete: SetNull)

  /// Soft delete for app events. Discord events cancelled on Discord are
  /// hard-deleted by the sync, like before the unification.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   Entity?   @relation("deletedEvents", fields: [deletedById], references: [id], onDelete: SetNull)

  visibility      EventVisibility       @default(PUBLIC)
  visibilityRoles EventVisibilityRole[]

  participants  EventParticipant[]
  positions     EventPosition[]
  lineupEnabled Boolean            @default(false)
  managers      Entity[]           @relation("eventManagers")
  activities    EventActivity[]

  /// Set when the briefing root page's read scope first left MANAGERS.
  /// Guards the one-time "briefing published" notification.
  briefingPublishedAt DateTime?
  wikiPages           WikiPage[]
  wikiTags            WikiTag[]

  @@index([startTime])
  @@index([endTime])
}

/// The roles a RESTRICTED event is visible to. Ignored for PUBLIC events.
model EventVisibilityRole {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, roleId])
}

/// One participation of one person in one event, from either source:
/// DISCORD rows mirror a Discord RSVP (identity is the Discord user id, the
/// citizen is resolved when possible), APP rows are in-app sign-ups
/// (identity is the citizen). Cancellation is a soft-cancel; every
/// re-sign-up creates a fresh row, so rows double as participation history.
model EventParticipant {
  id      String      @id @default(cuid())
  eventId String
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  source  EventSource

  citizenId     String?
  citizen       Entity? @relation("citizen", fields: [citizenId], references: [id], onDelete: Cascade)
  discordUserId String?

  comment String?

  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   Entity?   @relation("cancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  /// Mirror of citizenId/discordUserId while the row is active, NULL once
  /// cancelled: Postgres treats NULLs as distinct, so the unique constraints
  /// below enforce "at most one active row per person per event" while
  /// keeping any number of cancelled rows. Cancellation must NULL these in
  /// the same update that sets cancelledAt.
  activeCitizenId     String?
  activeDiscordUserId String?

  @@unique([eventId, activeCitizenId])
  @@unique([eventId, activeDiscordUserId])
  @@index([citizenId])
  @@index([discordUserId])
}

/// The in-event activity feed of app events, visible to everyone who can
/// see the event — deliberately separate from the admin-gated, immutable
/// AuditEvent system log. "Event start"/"event end" entries are rendered
/// synthetically from the event's startTime/endTime and never stored.
enum EventActivityType {
  CREATED
  TITLE_UPDATED
  DESCRIPTION_UPDATED
  SCHEDULE_UPDATED
  PARTICIPATION_SIGNED_UP
  PARTICIPATION_COMMENT_UPDATED
  PARTICIPATION_CANCELLED
  PARTICIPATION_ADDED_BY_MANAGER
  PARTICIPATION_REMOVED_BY_MANAGER
  LINEUP_TOGGLED
}

model EventActivity {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      EventActivityType
  payload   Json?
  citizenId String?
  citizen   Entity?           @relation("citizen", fields: [citizenId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([eventId, createdAt])
}

/// A reusable blueprint for standalone app events. Holds everything an event
/// creator would otherwise retype — title, description, cover, visibility
/// prefill, lineup and briefing — and stays detached from the events created
/// from it: nothing on an Event references its template.
///
/// Templates are personal by default and shared to roles via
/// EventTemplateRoleAccess. `ownedById` is the live permission-bearing owner
/// and transferable; `createdById` is a pure audit fact without permission
/// implications (wiki precedent, see WikiPage.ownerId).
model EventTemplate {
  id String @id @default(cuid(2))

  /// Names the template in every list and prefills the created event's
  /// title, which the organizer then adjusts — one field, because a template
  /// is recognized by the kind of event it produces.
  name        String
  /// Prefills the created event's description
  description String?

  /// Prefills the created event's cover image. Creating an event from the
  /// template copies the S3 object into a fresh Upload owned by the event
  /// creator, so the template keeps its own cover.
  coverImageId String?
  coverImage   Upload? @relation("eventTemplateCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)

  /// Prefills the created event's visibility and — for RESTRICTED — its
  /// visibility roles. Unrelated to who may see the template itself.
  visibility      EventVisibility               @default(PUBLIC)
  visibilityRoles EventTemplateVisibilityRole[]

  /// Who may use and edit the template (see EventTemplateAccessType)
  roleAccess EventTemplateRoleAccess[]

  /// The lineup and briefing blueprints, generalized to the event-or-template
  /// container (see EventPosition.templateId and WikiPage.templateId)
  positions EventPosition[]
  wikiPages WikiPage[]
  wikiTags  WikiTag[]

  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   Entity?   @relation("createdEventTemplates", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   Entity?   @relation("updatedEventTemplates", fields: [updatedById], references: [id], onDelete: SetNull)
  /// The live owner. NULL only when the owning citizen was deleted, which
  /// leaves the template manageable by `event;manage` holders alone.
  ownedById   String?
  ownedBy     Entity?   @relation("ownedEventTemplates", fields: [ownedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   Entity?   @relation("deletedEventTemplates", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([ownedById])
  @@index([deletedAt])
}

/// The roles prefilled into a RESTRICTED event created from the template.
/// Mirrors EventVisibilityRole and says nothing about template access.
model EventTemplateVisibilityRole {
  id         String        @id @default(cuid(2))
  templateId String
  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([templateId, roleId])
  @@index([roleId])
}

/// EDIT implies READ (see EventTemplate.roleAccess), so one role never needs
/// a second row. READ is "read and use", EDIT adds content editing —
/// sharing, ownership transfer and deletion stay with the owner.
enum EventTemplateAccessType {
  READ
  EDIT
}

model EventTemplateRoleAccess {
  id         String                  @id @default(cuid(2))
  templateId String
  template   EventTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role                    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  type       EventTemplateAccessType

  @@unique([templateId, roleId])
  @@index([roleId])
}

model EventPosition {
  id String @id @default(cuid())

  /// The container this position belongs to: exactly one of `eventId` and
  /// `templateId` is set (enforced by a CHECK constraint, see migration
  /// event_templates). Template positions are blueprints — they are never
  /// assigned a citizen and never carry applications.
  eventId    String?
  event      Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId String?
  template   EventTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  requiredVariants EventPositionRequiredVariant[]
  requiredRoles    Role[]
  applications     EventPositionApplication[]     @relation("applications")
  citizenId        String?
  citizen          Entity?                        @relation("citizen", fields: [citizenId], references: [id], onDelete: SetNull)
  parentPositionId String?
  parentPosition   EventPosition?                 @relation("parentPosition", fields: [parentPositionId], references: [id], onDelete: Cascade)
  childPositions   EventPosition[]                @relation("parentPosition")
  order            Int                            @default(0)
  fontSize         String?
  backgroundColor  String?
  textColor        String?

  /// Event wiki pages whose read/edit scope references this position's
  /// subtree (see WikiPage.eventReadScopePosition)
  wikiReadScopePages WikiPage[] @relation("wikiReadScopePages")
  wikiEditScopePages WikiPage[] @relation("wikiEditScopePages")

  @@index([eventId])
  @@index([templateId])
}

model EventPositionRequiredVariant {
  id         String        @id @default(cuid())
  positionId String
  position   EventPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order      Int           @default(99999)
}

model EventPositionApplication {
  id         String        @id @default(cuid())
  positionId String
  position   EventPosition @relation("applications", fields: [positionId], references: [id], onDelete: Cascade)
  citizenId  String
  citizen    Entity        @relation("citizen", fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([positionId, citizenId])
}
