model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime? @default(now())
  updatedAt         DateTime?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Deliberately without a database default: sessions created before this
  /// column existed must stay NULL rather than claim the timestamp of the
  /// migration. Set by the NextAuth adapter, the only writer.
  createdAt    DateTime?
  /// User agent of the browser the session was created from. NULL for
  /// sessions predating this column and for sign-ins without the header.
  userAgent    String?

  @@index([userId])
}

model User {
  id                         String                   @id @default(cuid())
  name                       String?
  email                      String?                  @unique
  emailVerified              DateTime?
  image                      String?
  accounts                   Account[]
  sessions                   Session[]
  role                       String?
  createdAt                  DateTime?                @default(now())
  updatedAt                  DateTime?
  ships                      Ship[]
  createdEntities            Entity[]                 @relation("createdBy")
  submittedEntityLogs        EntityLog[]              @relation("submittedBy")
  createdEntityLogAttributes EntityLogAttribute[]
  lastSeenAt                 DateTime?
  uploads                    Upload[]
  emailConfirmationTokens    EmailConfirmationToken[]
  createdVariantTags         VariantTag[]             @relation("createdBy")
  updatedVariantTags         VariantTag[]             @relation("updatedBy")
  createdAuditEvents         AuditEvent[]             @relation("createdBy")
  bannedAt                   DateTime?
  bannedReason               String?
  bannedById                 String?
  bannedBy                   Entity?                  @relation("bannedBy", fields: [bannedById], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailConfirmationToken {
  token   String   @id
  email   String
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires DateTime
}

model Role {
  id                        String                        @id @default(cuid())
  name                      String                        @unique
  iconId                    String?                       @map("imageId")
  icon                      Upload?                       @relation(name: "icon", fields: [iconId], references: [id], onDelete: SetNull)
  thumbnailId               String?                       @map("thumbnailId")
  thumbnail                 Upload?                       @relation(name: "thumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  permissionStrings         PermissionString[]
  flowNodes                 FlowNode[]                    @relation("flowNodes")
  inherits                  Role[]                        @relation("inheritance")
  inheritedBy               Role[]                        @relation("inheritance")
  eventPositions            EventPosition[]
  eventVisibilities         EventVisibilityRole[]
  eventTemplateVisibilities EventTemplateVisibilityRole[]
  eventTemplateAccess       EventTemplateRoleAccess[]
  tasksRequiredIn           Task[]                        @relation("requiredRoles")
  silcSalaries              SilcRoleSalary[]
  /// Number of days after which this role gets removed from a citizen due to
  /// their inactivity. NULL if inactivity is not tracked for this role. This
  /// is handled by application logic.
  maxAgeDays                Int?
  /// Number of days of inactivity after which this role is automatically
  /// assigned to a citizen. NULL if auto-assignment is not configured. This
  /// is handled by application logic.
  assignAfterInactiveDays   Int?
  assignments               RoleAssignment[]              @relation("role")
  assignmentChanges         RoleAssignmentChange[]        @relation("role")
  citizenCounts             RoleCitizenCount[]
  wikiPageAccess            WikiPageRoleAccess[]
  flowAccess                FlowRoleAccess[]

  /// Human-readable description of the role (markdown).
  description            String?
  /// Number of levels this role has. NULL if the role does not have levels.
  maxLevel               Int?
  assignmentLevelChanges RoleAssignmentLevelChange[] @relation("role")
  /// Number of days after which the role is considered inactive for a citizen.
  /// The inactivity is bound to the changes to their role level. NULL if
  /// inactivity is not tracked for this role. Inactive roles don't give the
  /// citizen any permissions. This is handled by application logic.
  inactivityThreshold    Int?

  @@index([maxAgeDays])
  @@index([assignAfterInactiveDays])
}

model PermissionString {
  id               String @id @default(cuid())
  roleId           String
  role             Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionString String
}
