model ProfitDistributionCycle {
  id                          String                               @id @default(cuid(2))
  title                       String
  collectionEndedAt           DateTime
  collectionEndedById         String?
  collectionEndedBy           Citizen?                             @relation("collectionEndedBy", fields: [collectionEndedById], references: [id], onDelete: SetNull)
  collectionEndedByAutomation DateTime?
  payoutStartedAt             DateTime?
  payoutStartedBy             Citizen?                             @relation("payoutStartedBy", fields: [payoutStartedById], references: [id], onDelete: SetNull)
  payoutStartedById           String?
  payoutEndedAt               DateTime?
  payoutEndedById             String?
  payoutEndedBy               Citizen?                             @relation("payoutEndedBy", fields: [payoutEndedById], references: [id], onDelete: SetNull)
  payoutEndedByAutomation     DateTime?
  auecProfit                  BigInt?
  participants                ProfitDistributionCycleParticipant[]
  silcTransactions            SilcTransaction[]
  createdAt                   DateTime                             @default(now())
  createdById                 String?
  createdBy                   Citizen?                             @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model ProfitDistributionCycleParticipant {
  id                  String                  @id @default(cuid(2))
  cycleId             String
  cycle               ProfitDistributionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  citizenId           String
  citizen             Citizen                 @relation("citizen", fields: [citizenId], references: [id], onDelete: Cascade)
  silcBalanceSnapshot Int?
  createdAt           DateTime                @default(now())
  cededAt             DateTime?
  cededById           String?
  cededBy             Citizen?                @relation("cededBy", fields: [cededById], references: [id], onDelete: SetNull)
  acceptedAt          DateTime?
  acceptedById        String?
  acceptedBy          Citizen?                @relation("acceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  disbursedAt         DateTime?
  disbursedById       String?
  disbursedBy         Citizen?                @relation("disbursedBy", fields: [disbursedById], references: [id], onDelete: SetNull)

  @@unique([cycleId, citizenId])
}
