{
  "name": "@sam-monorepo/wiki-editor",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./helpers": "./dist/helpers.js",
    "./markdown": "./dist/markdown.js"
  },
  "scripts": {
    "postinstall": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
