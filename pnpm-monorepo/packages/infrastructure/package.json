{
  "name": "@sam-monorepo/infrastructure",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "./dist/*"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "postinstall": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@sam-monorepo/application": "workspace:*",
    "@sam-monorepo/database": "workspace:*",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sam-monorepo/domain": "workspace:*",
    "@sam-monorepo/wiki-editor": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
