{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "composite": true,
    "declarationMap": true,
    /* The code of this package also runs in the browser: no Node.js globals,
       and only features that are Baseline "widely available" (ES2025 is not
       yet). */
    "types": [],
    "lib": ["es2024"]
  },
  "include": ["src/**/*.ts"]
}
