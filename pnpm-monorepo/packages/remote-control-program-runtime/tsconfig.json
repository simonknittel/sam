/* IDE/typecheck config covering sources and tests; the emitting build
   lives in tsconfig.build.json and excludes tests. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    /* The code of this package runs in the browser: only features that are
       Baseline "widely available" (ES2025 is not yet), and the DOM and
       worker APIs. */
    "lib": ["es2024", "dom", "dom.iterable"]
  },
  "include": ["src/**/*.ts"]
}
