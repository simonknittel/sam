{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "content": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "type",
        "id",
        "protocol_version",
        "content"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "refusal"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "content": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "token_not_valid",
                "update_necessary",
                "protocol_version_too_new",
                "relay_service_restart",
                "too_many_errors",
                "too_many_runtimes",
                "access_denied",
                "program_turned_off",
                "replaced",
                "heartbeat_missing"
              ]
            }
          },
          "required": [
            "reason"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "protocol_version",
        "content"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ack"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "result": {
                  "type": "string",
                  "const": "accepted"
                },
                "new_entry_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                }
              },
              "required": [
                "message_id",
                "result"
              ]
            },
            {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "result": {
                  "type": "string",
                  "const": "refused"
                },
                "error_code": {
                  "type": "string",
                  "enum": [
                    "message_not_valid",
                    "capability_not_announced",
                    "rate_limit_exceeded",
                    "entries_not_valid",
                    "token_not_valid",
                    "internal_error"
                  ]
                }
              },
              "required": [
                "message_id",
                "result",
                "error_code"
              ]
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "protocol_version",
        "content"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "close"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "content": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "token_not_valid",
                "update_necessary",
                "protocol_version_too_new",
                "relay_service_restart",
                "too_many_errors",
                "too_many_runtimes",
                "access_denied",
                "program_turned_off",
                "replaced",
                "heartbeat_missing"
              ]
            }
          },
          "required": [
            "reason"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "protocol_version",
        "content"
      ]
    }
  ]
}
