# Gitignored files that get copied into a new git worktree.
#
# Rule of thumb: list what a worktree cannot obtain on its own (local secrets,
# per-environment values) plus generated code that is cheap to copy and slow to
# rebuild. Everything installable — node_modules, .next, .terraform — is left
# out and recreated with `npm ci` / `pnpm install` / `terraform init`.

# Local environment files. Without these the app, the lambdas and the Playwright
# suite fail at startup on env validation.
app/.env
pnpm-monorepo/apps/lambda/.env
pnpm-monorepo/apps/playwright/.env
pnpm-monorepo/packages/database/.env

# Generated Prisma clients. Required for typecheck and build to resolve, and
# regenerating them needs a reachable database URL.
app/src/generated/
pnpm-monorepo/packages/database/src/generated/

# Written by `next dev`/`next build` but gitignored; tsc needs it to resolve the
# Next.js ambient types.
app/next-env.d.ts

# Per-environment infrastructure inputs that are not in git.
terraform/test.tfvars
cloudformation/test-parameters.json
