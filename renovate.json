{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "customManagers": [
    {
      "description": "The Playwright stack pins the same container images as compose.yml, but as TypeScript constants that no built-in manager reads.",
      "customType": "regex",
      "managerFilePatterns": [
        "pnpm-monorepo/apps/playwright/setup/stack.ts"
      ],
      "matchStrings": [
        "\"(?<depName>[^\"@:]+):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "groupName": "Patch Tuesday",
      "groupSlug": "patch-tuesday",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "schedule": [
        "before 7am on Tuesday"
      ],
      "matchPackageNames": [
        "!eslint-plugin-react-compiler"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "730 days"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "dependencyDashboardReportAbandonment": true,
  "configMigration": true,
  "prHourlyLimit": 10,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 5,
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 7am on Wednesday"
    ]
  },
  "pinDigests": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict"
}
